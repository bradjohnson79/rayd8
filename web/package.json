{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:amrita-dual-pass": "node scripts/amrita-dual-pass-regression.mjs",
    "test:global-player-runtime": "node scripts/global-player-runtime-regression.mjs",
    "test:no-playback-prompt": "node scripts/assert-no-playback-prompt.mjs",
    "test:mux-stability:smoke": "RAYD8_MUX_STABILITY_MODE=smoke node scripts/mux-playback-stability.mjs",
    "test:mux-stability:soak": "RAYD8_MUX_STABILITY_MODE=soak node scripts/mux-playback-stability.mjs",
    "test:mux-stability:closure": "node scripts/mux-closure.mjs",
    "test:amrita-mux-stability": "node scripts/amrita-mux-stability.mjs",
    "test:recovery-machine": "node --import ../api/node_modules/tsx/dist/esm/index.mjs --test src/features/playback-authority/recoveryStateMachine.test.ts",
    "test:av-sync": "node --import ../api/node_modules/tsx/dist/esm/index.mjs --test src/features/rayd8-player/avSyncController.test.ts",
    "test:mux-telemetry": "node --import ../api/node_modules/tsx/dist/esm/index.mjs --test src/features/rayd8-player/playbackIncidentTelemetry.test.ts",
    "test:thermal-regression": "node scripts/thermal-performance-regression.mjs",
    "test:thermal-units": "node --import ../api/node_modules/tsx/dist/esm/index.mjs --test src/features/performance/visualPerformancePreference.test.ts src/features/performance/runtimeResourceRegistry.test.ts src/features/rayd8-player/playbackVisibilityPolicy.test.ts",
    "test:adaptive-units": "node --import ../api/node_modules/tsx/dist/esm/index.mjs --test src/features/performance/adaptivePerformancePolicy.test.ts src/features/performance/performanceSampler.test.ts src/features/performance/runtimeControllers.test.ts src/features/performance/expressMediaNetworkPolicy.test.ts src/features/performance/adaptiveClockInvariance.test.ts",
    "test:adaptive-smoke": "node scripts/adaptive-performance-smoke.mjs",
    "test:thermal-budgets": "node scripts/thermal-budget-gates.mjs",
    "test:thermal-behavior": "node scripts/thermal-behavior-smoke.mjs",
    "test:thermal-soak:short": "RAYD8_MUX_SOAK_MS=300000 RAYD8_AMRITA_SHORT_MS=300000 node scripts/amrita-mux-stability.mjs",
    "test:thermal-soak:30m": "RAYD8_MUX_SOAK_MS=1800000 node scripts/amrita-mux-stability.mjs",
    "test:session-startup-unit": "node --import ../api/node_modules/tsx/dist/esm/index.mjs --test src/features/rayd8-player/sessionStartupTaxonomy.test.ts src/features/rayd8-player/playbackHealthStateMachine.test.ts src/features/rayd8-player/mediaController.forceReload.test.ts",
    "test:session-startup-closure": "npm run test:session-startup-unit && npm run test:no-playback-prompt && npm run test:mux-telemetry"
  },
  "dependencies": {
    "@clerk/react": "^6.4.2",
    "@tailwindcss/vite": "^4.2.2",
    "framer-motion": "^12.38.0",
    "hls.js": "^1.6.16",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.14",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
