{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/rayd8-express-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.rayd8.app"
        }
      ],
      "destination": "https://rayd8.app/$1",
      "permanent": true
    },
    { "source": "/start/", "destination": "/start", "permanent": false },
    { "source": "/subscription/", "destination": "/subscription", "permanent": false },
    { "source": "/signup/", "destination": "/signup", "permanent": false },
    { "source": "/rayd8-affiliate/", "destination": "/rayd8-affiliate", "permanent": false },
    { "source": "/success/", "destination": "/success", "permanent": false },
    { "source": "/privacy/", "destination": "/privacy", "permanent": false },
    { "source": "/terms/", "destination": "/terms", "permanent": false },
    { "source": "/dashboard/", "destination": "/dashboard", "permanent": false },
    { "source": "/dashboard/:path*/", "destination": "/dashboard/:path*", "permanent": false },
    { "source": "/player/", "destination": "/player", "permanent": false },
    { "source": "/contact/", "destination": "/contact", "permanent": false },
    { "source": "/instructions/", "destination": "/instructions", "permanent": false },
    { "source": "/settings/", "destination": "/settings", "permanent": false },
    { "source": "/amrita-dashboard/", "destination": "/amrita-dashboard", "permanent": false },
    { "source": "/amrita/", "destination": "/amrita", "permanent": false },
    { "source": "/admin/", "destination": "/admin", "permanent": false },
    { "source": "/admin/:path*/", "destination": "/admin/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/start", "destination": "/start.html" },
    { "source": "/subscription", "destination": "/index.html" },
    { "source": "/signup", "destination": "/index.html" },
    { "source": "/rayd8-affiliate", "destination": "/index.html" },
    { "source": "/success", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/affiliate", "destination": "/index.html" },
    { "source": "/dashboard/hamsa", "destination": "/index.html" },
    { "source": "/dashboard/amrita", "destination": "/index.html" },
    { "source": "/dashboard/instructions", "destination": "/index.html" },
    { "source": "/dashboard/settings", "destination": "/index.html" },
    { "source": "/dashboard/upgrade", "destination": "/index.html" },
    { "source": "/player", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/instructions", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/amrita-dashboard", "destination": "/index.html" },
    { "source": "/amrita", "destination": "/index.html" },
    { "source": "/amrita_app", "destination": "/index.html" },
    { "source": "/amrita_app/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/preview/free", "destination": "/index.html" },
    { "source": "/admin/preview/regen", "destination": "/index.html" },
    { "source": "/admin/instructions", "destination": "/index.html" },
    { "source": "/admin/expansion", "destination": "/index.html" },
    { "source": "/admin/premium", "destination": "/index.html" },
    { "source": "/admin/regen", "destination": "/index.html" },
    { "source": "/admin/hamsa", "destination": "/index.html" },
    { "source": "/admin/amrita", "destination": "/index.html" },
    { "source": "/admin/prime", "destination": "/index.html" },
    { "source": "/admin/global-players", "destination": "/index.html" },
    { "source": "/admin/global-players/:playerId", "destination": "/index.html" },
    { "source": "/admin/settings", "destination": "/index.html" },
    { "source": "/admin/orders", "destination": "/index.html" },
    { "source": "/admin/subscribers", "destination": "/index.html" },
    { "source": "/admin/promo-codes", "destination": "/index.html" },
    { "source": "/admin/affiliates", "destination": "/index.html" },
    { "source": "/admin/analytics", "destination": "/index.html" },
    { "source": "/admin/mux", "destination": "/index.html" },
    { "source": "/admin/messages", "destination": "/index.html" },
    { "source": "/admin/notifications", "destination": "/index.html" },
